# Copy to .env and fill in. Never commit .env.

# Port to listen on (Render sets this automatically)
PORT=3000

# Key clients must send in the x-api-key header. Use a long random string.
SERVICE_API_KEY=replace-with-a-long-random-string

# Which LLM provider to use: anthropic | openai | mock
LLM_PROVIDER=mock

# Only the key for the selected provider is required
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key

# Optional model override. Defaults: claude-opus-5-5 (anthropic), gpt-6-astra (openai)
# LLM_MODEL=
